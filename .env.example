# ============================================
# CodeForge Root Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# Server Port
PORT=3001

# --- LLM Providers ---
# Primary: Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# Secondary / Fallback: Groq (https://console.groq.com)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Offline Mock Generator (true for zero-cost offline benchmark testing)
USE_MOCK_LLM=false

# --- Execution Sandbox ---
USE_DOCKER=false
SANDBOX_IMAGE=python:3.12-slim

# --- PostgreSQL Database ---
# Local: postgresql://postgres:password@localhost:5432/codeforge
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codeforge

# --- Benchmark Runner ---
# Pause between tasks in ms (prevents 429 rate limits on free tier)
BENCH_DELAY_MS=3500
