# ============================================
# CodeForge Root Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# Server Port
PORT=3001

# --- LLM Providers ---
# Primary: Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Secondary / Fallback: Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# Offline Mock Generator (true for zero-cost offline benchmark testing)
USE_MOCK_LLM=false

# --- Execution Sandbox ---
USE_DOCKER=false
SANDBOX_IMAGE=python:3.12-slim

# --- PostgreSQL Database ---
# Local: postgresql://postgres:password@localhost:5432/codeforge
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codeforge

# --- Benchmark Runner ---
# Pause between tasks in ms (prevents 429 rate limits on free tier)
BENCH_DELAY_MS=3500
