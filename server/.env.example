# ============================================
# CodeForge Server Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# Server Port
PORT=3001

# --- LLM Providers ---
# CodeForge supports Anthropic Claude and Google Gemini with automatic fallback.
# Set either or both:

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini (Free Tier / Fallback)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# Offline Mock Generator (Set to true for 100% offline testing with no API calls)
USE_MOCK_LLM=false

# --- Execution Sandbox ---
# Set to true only if Docker Desktop is installed and running; otherwise falls back to local subprocess
USE_DOCKER=false
SANDBOX_IMAGE=python:3.12-slim

# --- PostgreSQL Database ---
# Local example:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/codeforge
# Cloud / Supabase / Neon example:
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codeforge

# --- Environment ---
NODE_ENV=development
