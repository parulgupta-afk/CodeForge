# ============================================
# CodeForge Environment Variables
# Copy this file to .env and fill in the values
# ============================================

# Server
PORT=3001

# Anthropic (primary LLM)
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Optional: Gemini fallback
# GEMINI_API_KEY=your-gemini-key
# GEMINI_MODEL=gemini-2.5-flash

# Optional: Force offline mock (no API key needed)
# USE_MOCK_LLM=true

# Docker Sandbox (Phase 5)
# Set to true only if Docker Desktop is running
USE_DOCKER=false
SANDBOX_IMAGE=python:3.12-slim

# PostgreSQL (Phase 7)
# Local example:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/codeforge
# Neon / Supabase example:
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# DB_SSL=true

DATABASE_URL=

# --- Production ---
# NODE_ENV=production
# Tighten CORS in server.ts to your Vercel domain when deploying
