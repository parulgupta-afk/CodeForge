# ============================================================
# CodeForge Backend — canonical environment file
# Copy to server/.env  (never commit .env)
# ============================================================

# --- Required for a normal LLM demo (pick at least one) ---
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Groq (fallback): https://console.groq.com
GROQ_API_KEY=
# Optional model override (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# --- Offline / CI / no API keys ---
# true = never call Gemini/Groq; use deterministic mock generator
USE_MOCK_LLM=false

# --- Server ---
PORT=3001
# Optional. Allowed frontend origin(s) for Express & Socket.IO CORS (comma-separated).
# In development, defaults to http://localhost:5173,http://127.0.0.1:5173 when unset.
# CORS_ORIGIN=http://localhost:5173

# --- Optional security & rate limiting ---
# Maximum POST /api/runs requests per 15-minute window (default: 100)
# RUN_RATE_LIMIT=100

# --- Execution sandbox ---
# false = local Python subprocess (DEFAULT for local/dev and docker-compose)
#         NOT a security boundary. OK for solo demos on your machine.
# true  = Docker container per run (network none, memory/CPU/PID limits, non-root)
#         Requires Docker Desktop/daemon on the host running the Node process.
USE_DOCKER=false
SANDBOX_IMAGE=python:3.12-slim

# --- Optional persistence ---
# If unset, runs stay in memory only.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codeforge
# DB_SSL=false

# --- Benchmark only ---
# BENCH_DELAY_MS=3500

