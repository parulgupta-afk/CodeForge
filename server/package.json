{
  "name": "codeforge-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "ts-node --transpile-only src/__tests__/errorClassifier.test.ts && ts-node --transpile-only src/__tests__/orchestrator.test.ts && ts-node --transpile-only src/__tests__/providerFallback.test.ts && ts-node --transpile-only src/__tests__/localExecutor.test.ts",
    "test:classifier": "ts-node --transpile-only src/__tests__/errorClassifier.test.ts",
    "test:orchestrator": "ts-node --transpile-only src/__tests__/orchestrator.test.ts",
    "test:providers": "ts-node --transpile-only src/__tests__/providerFallback.test.ts",
    "test:sandbox": "ts-node --transpile-only src/__tests__/localExecutor.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dockerode": "^4.0.2",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.2.0",
    "pg": "^8.13.0",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/dockerode": "^3.3.31",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
